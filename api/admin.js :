export default async function handler(req, res) {
  // Autoriser la méthode POST uniquement
  if (req.method !== 'POST') {
    return res.status(405).json({ erreur: 'Méthode non autorisée' });
  }

  try {
    const { motDePasseAdmin, action, commandeId } = req.body || {};

    // Vérification du mot de passe admin
    if (motDePasseAdmin !== 'delfioficiel') {
      return res.status(401).json({ erreur: 'Mot de passe incorrect' });
    }

    // 1. Chargement des données (Partenaires et Commandes)
    if (!action || action === 'connexion' || action === 'charger_donnees' || action === 'get_data') {
      return res.status(200).json({
        succes: true,
        message: 'Connexion réussie',
        partenaires: [],
        commandes: []
      });
    }

    // 2. Création d'un partenaire
    if (action === 'creer_partenaire' || action === 'ajouter_partenaire') {
      return res.status(200).json({
        succes: true,
        message: 'Partenaire créé avec succès !'
      });
    }

    // 3. Validation du paiement
    if (action === 'valider_paiement') {
      return res.status(200).json({
        succes: true,
        message: `Paiement validé pour la commande ${commandeId}.`
      });
    }

    // 4. Annulation d'une commande
    if (action === 'annuler_commande') {
      return res.status(200).json({
        succes: true,
        message: `Commande ${commandeId} annulée.`
      });
    }

    return res.status(200).json({ succes: true, partenaires: [], commandes: [] });

  } catch (err) {
    return res.status(500).json({ erreur: 'Erreur serveur' });
  }
}
